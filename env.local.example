# Copy this file to .env.local and fill it in. Never commit .env.local.
# On Vercel add these variables under Project Settings > Environment Variables.

MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/intelliseat
JWT_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-separate-long-random-secret
ADMIN_ORIGIN=http://localhost:5173
# Expo web dev origins on localhost/private LAN are allowed on ports 8081 and 19006 in development only.
ALLOWED_ORIGINS=http://localhost:5173
